# Salin file ini menjadi .env.local lalu isi nilainya.
# Supabase Dashboard > Project Settings > API Keys / Data API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: direct Postgres connection (ORM / migrasi / psql)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Server-only: Fast Login akun demo (JANGAN gunakan prefix NEXT_PUBLIC_)
# Sementara aktif di semua environment (termasuk production/Vercel); atur "false" untuk menonaktifkan.
ENABLE_FAST_LOGIN=true
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_PETUGAS_EMAIL=
DEMO_PETUGAS_PASSWORD=
DEMO_PELAPOR_EMAIL=
DEMO_PELAPOR_PASSWORD=

# Opsional sementara untuk menjalankan `node scripts/provision-demo-users.mjs` secara lokal.
# JANGAN pernah diberi prefix NEXT_PUBLIC_ atau disimpan di Git.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key


